<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <display-name>Finora Development Foundation</display-name>

    <context-param>
        <param-name>db.driver</param-name>
        <param-value>com.microsoft.sqlserver.jdbc.SQLServerDriver</param-value>
    </context-param>
    <context-param>
        <param-name>db.url</param-name>
        <param-value>jdbc:sqlserver://localhost:1433;databaseName=DBFinora;encrypt=true;trustServerCertificate=true</param-value>
    </context-param>
    <context-param>
        <param-name>db.username</param-name>
        <param-value>sa</param-value>
    </context-param>
    <context-param>
        <param-name>db.password</param-name>
        <param-value></param-value>
    </context-param>

    <listener>
        <listener-class>controller.AppStartupListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>HomeDashboardServlet</servlet-name>
        <servlet-class>controller.HomeDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeDashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RoleSelectionServlet</servlet-name>
        <servlet-class>controller.RoleSelectionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoleSelectionServlet</servlet-name>
        <url-pattern>/role-selection</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SkeletonModuleServlet</servlet-name>
        <servlet-class>controller.SkeletonModuleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SkeletonModuleServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/login/*</url-pattern>
        <url-pattern>/employee-management</url-pattern>
        <url-pattern>/employee-management/*</url-pattern>
        <url-pattern>/authorization</url-pattern>
        <url-pattern>/authorization/*</url-pattern>
        <url-pattern>/branch-management</url-pattern>
        <url-pattern>/branch-management/*</url-pattern>
        <url-pattern>/product-management</url-pattern>
        <url-pattern>/product-management/*</url-pattern>
        <url-pattern>/category-management</url-pattern>
        <url-pattern>/category-management/*</url-pattern>
        <url-pattern>/supplier-management</url-pattern>
        <url-pattern>/supplier-management/*</url-pattern>
        <url-pattern>/purchase-management</url-pattern>
        <url-pattern>/purchase-management/*</url-pattern>
        <url-pattern>/inventory-management</url-pattern>
        <url-pattern>/inventory-management/*</url-pattern>
        <url-pattern>/warehouse-management</url-pattern>
        <url-pattern>/warehouse-management/*</url-pattern>
        <url-pattern>/stock-transfer</url-pattern>
        <url-pattern>/stock-transfer/*</url-pattern>
        <url-pattern>/sales-management</url-pattern>
        <url-pattern>/sales-management/*</url-pattern>
        <url-pattern>/order-management</url-pattern>
        <url-pattern>/order-management/*</url-pattern>
        <url-pattern>/payment-management</url-pattern>
        <url-pattern>/payment-management/*</url-pattern>
        <url-pattern>/invoice-management</url-pattern>
        <url-pattern>/invoice-management/*</url-pattern>
        <url-pattern>/customer-management</url-pattern>
        <url-pattern>/customer-management/*</url-pattern>
        <url-pattern>/financial-management</url-pattern>
        <url-pattern>/financial-management/*</url-pattern>
        <url-pattern>/reports</url-pattern>
        <url-pattern>/reports/*</url-pattern>
        <url-pattern>/website</url-pattern>
        <url-pattern>/website/*</url-pattern>
        <url-pattern>/website-management</url-pattern>
        <url-pattern>/website-management/*</url-pattern>
        <url-pattern>/seo-management</url-pattern>
        <url-pattern>/seo-management/*</url-pattern>
        <url-pattern>/system-configuration</url-pattern>
        <url-pattern>/system-configuration/*</url-pattern>
        <url-pattern>/audit-log</url-pattern>
        <url-pattern>/audit-log/*</url-pattern>
        <url-pattern>/notifications</url-pattern>
        <url-pattern>/notifications/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
